# إعدادات التشغيل – عدّل القيم ثم أعد تشغيل السيرفر. السطر الذي يبدأ بـ # لا يُنفَّذ.

# المنفذ: غيّره إن كان 3000 مشغولاً
PORT=3000

# لجعل الموقع يعمل على هذا الجهاز فقط (بدون الأجهزة الأخرى في الشبكة) أزل # من السطر التالي
# HOST=127.0.0.1

# رمز دخول احتياطي للوحة التحكم (8 أحرف أو أكثر). الرمز الافتراضي TARIQ123 يعمل أيضاً حتى تغيّره من اللوحة.
# ADMIN_PASSWORD=

# معرّف عميل جوجل (Google OAuth Client ID) مطلوب لتسجيل الدخول والتحقق من التقييمات. أضفه في متغيرات بيئة Render.
# GOOGLE_CLIENT_ID=
